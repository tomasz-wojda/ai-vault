{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/git-handoff-baseline.py",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/git-handoff-guard-git.py",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/git-handoff-shell-baseline.py",
        "failClosed": true,
        "matcher": "Shell"
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/git-handoff-shell-attribution.py",
        "failClosed": true,
        "matcher": "Shell"
      }
    ],
    "postToolUseFailure": [
      {
        "command": ".cursor/hooks/git-handoff-shell-attribution.py",
        "failClosed": true,
        "matcher": "Shell"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/git-handoff-file-attribution.py",
        "failClosed": true
      }
    ],
    "afterAgentResponse": [
      {
        "command": ".cursor/hooks/git-handoff-capture-response.py",
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/git-handoff-require-handoff.py",
        "failClosed": true,
        "loop_limit": 2
      }
    ]
  }
}
